{
  "name": "pstack-for-opencode",
  "version": "0.1.0-beta.2",
  "description": "Lauren Tan's pstack, packaged as a native OpenCode plugin",
  "type": "module",
  "main": "index.js",
  "exports": "./index.js",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "opencode",
    "pstack",
    "poteto-mode",
    "agent-skills",
    "plugin"
  ],
  "files": [
    "index.js",
    "src",
    "scripts",
    "vendor",
    "references",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "hash": "node scripts/hash-vendor.mjs",
    "generate": "node scripts/generate.mjs",
    "sync": "node scripts/sync-upstream.mjs",
    "verify": "node scripts/verify.mjs",
    "audit": "node scripts/audit-translation.mjs",
    "test": "node --test test/",
    "check": "node scripts/verify.mjs && node scripts/audit-translation.mjs && node --test test/",
    "prepack": "node scripts/generate.mjs && node scripts/verify.mjs",
    "prepublishOnly": "node -e \"throw new Error('Build with npm run pack:beta, then publish the verified tarball, not this directory')\"",
    "pack:beta": "node scripts/pack-beta.mjs",
    "pack:check": "node scripts/pack-beta.mjs --check"
  }
}
